# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env ขึ้น GitHub)
# บน Render ให้ใส่ค่าเหล่านี้ในหน้า Environment แทน

# ---- จำเป็น ----
# หาได้ทั้งใน LINE Official Account Manager > ตั้งค่า > Messaging API
# หรือ LINE Developers Console > channel ของร้าน > Basic settings
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ---- ไม่บังคับ ----
# ถ้าไม่ใส่ เซิร์ฟเวอร์จะขอ token จาก LINE เองด้วย Channel ID + secret (อายุ 30 วัน ขอใหม่ให้อัตโนมัติ)
LINE_CHANNEL_ACCESS_TOKEN=

# ผู้รับข้อความตอนกดหน้าเว็บจำลอง
# ถ้าไม่ใส่ ระบบจะใช้คนล่าสุดที่แอดเพื่อนหรือทักแชทร้าน (พิมพ์ myid ในแชทร้านเพื่อดู user ID ของตัวเอง)
LINE_DEMO_USER_ID=

# URL สาธารณะของเซิร์ฟเวอร์ ใช้ตั้ง Webhook URL ใน LINE ให้อัตโนมัติ
# บน Render ไม่ต้องใส่ เพราะ Render ใส่ RENDER_EXTERNAL_URL ให้เอง
PUBLIC_URL=

SHOP_NAME=Beacon Brew

# ส่งข้อความซ้ำให้คนเดิมที่ beacon เดิมได้อีกครั้งหลังกี่ชั่วโมง
COOLDOWN_HOURS=24

# เปิดหน้าเว็บจำลอง (ปิดเป็น false ตอนใช้งานจริง)
SIMULATOR_ENABLED=true

PORT=3000
